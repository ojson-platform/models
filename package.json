{
  "name": "@ojson/models",
  "version": "1.2.0",
  "description": "Declarative data retrieval with automatic memoization for server-side TypeScript applications",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "prepare": "husky install",
    "prebuild": "rm -rf build",
    "build": "tsc",
    "test": "pnpm -s run test:units && pnpm -s run test:types",
    "test:units": "vitest --run",
    "test:units:fast": "vitest --run --exclude 'examples/**'",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:fast": "vitest --run --coverage --exclude 'examples/**'",
    "test:types": "tsc -p tsconfig.types.json",
    "test:integration": "vitest --run examples/",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "models",
    "memoization",
    "declarative",
    "server-side",
    "typescript",
    "express",
    "caching",
    "telemetry",
    "opentelemetry"
  ],
  "author": {
    "name": "3y3",
    "email": "3y3@ya.ru",
    "url": "https://github.com/3y3"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ojson-platform/models.git"
  },
  "bugs": {
    "url": "https://github.com/ojson-platform/models/issues"
  },
  "homepage": "https://github.com/ojson-platform/models#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-node": "^0.202.0",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "zod": "^4.3.5"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ojson/infra": "workspace:*",
    "@opentelemetry/context-async-hooks": "^2.2.0",
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@types/node": "^25.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "vitest-when": "^0.10.0"
  }
}

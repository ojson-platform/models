{
  "name": "@your-scope/your-package",
  "version": "0.1.0",
  "description": "Your package description",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "prepare": "husky install",
    "prebuild": "rm -rf build",
    "build": "tspc",
    "test": "npm run test:units && npm run test:types",
    "test:units": "vitest --run",
    "test:units:fast": "vitest --run --exclude 'examples/**'",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:fast": "vitest --run --coverage --exclude 'examples/**'",
    "test:types": "tspc -p tsconfig.types.json",
    "test:integration": "vitest --run examples/",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "your",
    "keywords",
    "here"
  ],
  "author": {
    "name": "Your Name",
    "email": "your-email@example.com",
    "url": "https://github.com/your-username"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/your-organization/your-repo.git"
  },
  "bugs": {
    "url": "https://github.com/your-organization/your-repo/issues"
  },
  "homepage": "https://github.com/your-organization/your-repo#readme",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "ts-patch": "^3.3.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.3"
  }
}

